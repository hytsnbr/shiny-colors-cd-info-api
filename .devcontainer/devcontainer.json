{
  "name": "Deno",
  "build": {
    "dockerfile": "Dockerfile"
  },
  "runArgs": [
    "--name",
    "shiny-colors-cd-info-api"
  ],
  // GitHub CLI は Dockerfile に手書きせず、公式Featureで導入
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1.1.2": {}
  },
  "postAttachCommand": "deno task init",
  // Configure tool-specific properties.
  "customizations": {
    // Configure properties specific to VS Code.
    "vscode": {
      // Set *default* container specific settings.json values on container create.
      "settings": {
        // Enables the project as a Deno project
        "deno.enable": true,
        // Enables Deno linting for the project
        "deno.lint": true,
        // Sets Deno as the default formatter for the project
        "editor.defaultFormatter": "denoland.vscode-deno",
        // Sets the path to the Deno binary in the container
        "deno.path": "/usr/bin/deno",
        "deno.cache": "/home/vscode/.cache/deno"
      },
      // Add the IDs of extensions you want installed when the container is created.
      "extensions": [
        "denoland.vscode-deno",
        "aaron-bond.better-comments",
        "vivaxy.vscode-conventional-commits",
        "EditorConfig.EditorConfig",
        "usernamehw.errorlens",
        "mhutchie.git-graph",
        "donjayamanne.githistory",
        "eamodio.gitlens",
        "ryu1kn.partial-diff",
        "hbenl.vscode-test-explorer",
        "wayou.vscode-todo-highlight",
        "redhat.vscode-yaml",
        "justjavac.vscode-deno-extensionpack",
        "tamasfe.even-better-toml",
        "RapidAPI.vscode-rapidapi-client",
        "github.vscode-github-actions",
        "rangav.vscode-thunder-client",
        "jbockle.jbockle-format-files",
        "FanaticPythoner.better-todo-tree",
        "AndrewButson.vscode-openapi-viewer"
      ]
    }
  },
  "remoteUser": "vscode"
}
